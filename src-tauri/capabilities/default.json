{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "enables the default permissions",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "shell:default",
    {
      "identifier": "shell:allow-execute",
      "allow": [
        {
          "name": "yt-dlp",
          "sidecar": true
        },
        {
          "name": "ffmpeg",
          "sidecar": true
        }
      ]
    },
    "shell:allow-open",
    "dialog:default"
  ]
}
